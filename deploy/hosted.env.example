# Full environment example for local Docker preflight only. Copy outside the
# repository, replace placeholders and restrict access before adding values.
# For Fly, public settings go in fly.toml; secrets are imported via stdin using
# docs/managed-pc/FLY_HOSTED_RUNBOOK.md. This file does not load automatically.
AIQA_PROFILE=hosted
AIQA_PORT=8000
AIQA_RUNTIME_ROOT=/tmp/aiqa
AIQA_PUBLIC_ORIGIN=https://replace-with-your-app.fly.dev
AIQA_TRUSTED_PROXIES=replace-with-observed-proxy-peer
AIQA_DATABASE_BACKEND=postgres
AIQA_DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/postgres?sslmode=require
AIQA_ARTIFACT_BACKEND=supabase
AIQA_SUPABASE_URL=https://replace-project.supabase.co
AIQA_SUPABASE_SERVICE_KEY=replace-with-server-secret-key
AIQA_SUPABASE_BUCKET=private-evidence
AIQA_SECRET_ACCOUNT=aiqa-server
AIQA_OIDC_ISSUER=https://replace-with-your-issuer
AIQA_OIDC_CLIENT_ID=replace-with-client-id
AIQA_OIDC_AUDIENCE=replace-with-client-id
AIQA_OIDC_AUTHORIZE_ENDPOINT=https://replace-with-your-issuer/authorize
AIQA_OIDC_TOKEN_ENDPOINT=https://replace-with-your-issuer/token
AIQA_HOSTED_SECRETS_JSON={"AIQA/aiqa-server/oidc/client_secret":"replace-with-oidc-client-secret"}
AIQA_RECEIPT_HMAC_KEY=replace-with-base64-of-32-random-bytes
AIQA_MODEL_PROVIDER_MODE=openai
