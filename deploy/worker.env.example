# Non-secret Android worker settings. Set these in the dedicated worker session.
# Server DB/Storage/OIDC/receipt/model keys must never be copied to this PC.
AIQA_MANAGEMENT_BASE_URL=https://replace-with-your-unique-app.fly.dev
AIQA_WORKER_PROJECT_ID=replace-with-bootstrap-project-uuid
AIQA_WORKER_VERIFY_TLS=true
AIQA_WORKER_MODEL_MODE=operational
AIQA_WORKER_RUNTIME_ROOT=C:\AIQA\worker-runtime
AIQA_ADB_PATH=C:\Android\platform-tools\adb.exe
AIQA_ANDROID_SERIAL=emulator-5554
AIQA_ANDROID_AVD=replace-with-approved-avd
AIQA_ANDROID_VIDEO=1
# AIQA_WORKER_TOKEN is obtained by exchanging an expiring enrollment code.
# Keep it in the current process environment; do not save it in this file.
