# Copy to fly.toml, set app/origin/proxy peer and OIDC values, then validate.
# Runtime secrets belong in Fly secrets, never this file or the image.
app = "replace-with-your-unique-app"
primary_region = "nrt"
kill_signal = "SIGTERM"
kill_timeout = "30s"

[build]
  dockerfile = "Dockerfile"

[env]
  AIQA_PROFILE = "hosted"
  AIQA_PORT = "8000"
  AIQA_RUNTIME_ROOT = "/tmp/aiqa"
  AIQA_PUBLIC_ORIGIN = "https://replace-with-your-unique-app.fly.dev"
  # Confirm the actual TCP peer of Fly Proxy before setting this; never '*'/0 CIDR.
  AIQA_TRUSTED_PROXIES = "replace-with-confirmed-proxy-peer"
  AIQA_ARTIFACT_BACKEND = "supabase"
  AIQA_DATABASE_BACKEND = "postgres"
  AIQA_SUPABASE_BUCKET = "private-evidence"
  AIQA_SECRET_ACCOUNT = "aiqa-server"
  AIQA_OIDC_ISSUER = "https://replace-with-approved-issuer"
  AIQA_OIDC_CLIENT_ID = "replace-with-client-id"
  AIQA_OIDC_AUDIENCE = "replace-with-audience"
  AIQA_OIDC_AUTHORIZE_ENDPOINT = "https://replace-with-approved-issuer/authorize"
  AIQA_OIDC_TOKEN_ENDPOINT = "https://replace-with-approved-issuer/token"
  AIQA_MODEL_PROVIDER_MODE = "openai"

# A service TCP check measures liveness only, without forwarding/auth bypasses.
[[services]]
  protocol = "tcp"
  internal_port = 8000
  auto_stop_machines = "off"
  auto_start_machines = false
  min_machines_running = 1

  [[services.ports]]
    port = 80
    handlers = ["http"]
    force_https = true

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

  [[services.tcp_checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "60s"

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory = "512mb"
