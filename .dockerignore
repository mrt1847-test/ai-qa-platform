!third_party/mobile_agent/upstream/utils.py
!third_party/mobile_agent/upstream/packages.py
!third_party/mobile_agent/upstream/LICENSE
**/__pycache__/
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.pfx
**/*secrets*.json
